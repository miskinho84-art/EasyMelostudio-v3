# ==========================================
# EasyMelo Studio — Variables d'environnement
# ==========================================
# Copier ce fichier en ".env.local" et remplir les valeurs.
# Ne jamais committer le fichier ".env.local".

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EasyMelo Studio

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé privée : jamais préfixée NEXT_PUBLIC_, jamais utilisée côté client.
# Réservée aux futurs traitements serveur (non utilisée à ce jour).
SUPABASE_SERVICE_ROLE_KEY=

# --- Base de données (PostgreSQL via Supabase) ---
DATABASE_URL=

# --- API musicale (sera intégrée à l'étape 8) ---
MUSIC_API_KEY=
MUSIC_API_URL=

# --- Paiements / Abonnements (sera intégré à l'étape 7) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
